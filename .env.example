# Copy this file to ".env" (no .example) in the same folder, and fill in
# your real values. The app loads this automatically on startup — no need
# to run "export" commands in your terminal.

EMAIL_ADDRESS=youraddress@gmail.com
EMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_TO=youraddress@gmail.com

DAILY_CHECK_TIME=16:30
AUTOTRADE_RUN_TIME=09:35

# Where the SQLite database file lives. On Railway, point this inside your
# mounted volume (e.g. /data/watchlist.db) so it survives redeploys.
DB_PATH=watchlist.db

# Shared market-data keys, used only for the Watchlist page's live price
# ticker (every user shares this one). Each user's own AutoTrade trading
# keys are entered separately, per-account, on the AutoTrade page itself.
ALPACA_API_KEY=your_alpaca_key_id
ALPACA_SECRET_KEY=your_alpaca_secret_key

# Must be explicitly "false" to place real trades with real money. Do not
# flip this until you're genuinely ready, and even then, start small.
PAPER_TRADING=true

# Used only once, to seed one admin account the first time this app runs
# against a pre-multi-user database. Every other login goes through
# /register. Change these before deploying anywhere public.
APP_USERNAME=admin
APP_PASSWORD=changeme

# Any long random string — signs session cookies. Doesn't need to be
# memorable, just unique and secret. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=please-change-this-secret-key

# Set to "true" once deployed behind HTTPS (Railway provides this
# automatically). Leave "false" for local http://localhost testing.
SESSION_COOKIE_SECURE=false
